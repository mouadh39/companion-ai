{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "tsconfig.tsbuildinfo"]
    },

    "typecheck": {
      "dependsOn": ["build"],
      "outputs": []
    },

    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },

    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },

    "clean": { "cache": false },
    "dev": { "cache": false, "persistent": true }
  }
}
