# ─────────────────────────────────────────────────────────────
# Nexa — monorepo root ignore rules.
#
# Client- and engine-specific rules live with their own project so their
# anchored patterns resolve correctly:
#   Unity/Nexa/.gitignore   — Unity (Library/, Temp/, Logs/, obj/, ...)
#
# Anchored patterns (a leading "/") only match at the directory holding the
# .gitignore. Keeping the Unity rules here instead would silently fail to
# match Unity/Nexa/Library/ — which is exactly how ~32k generated files
# nearly landed in this repository.
# ─────────────────────────────────────────────────────────────

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# Build output
dist/
build/
out/
*.tsbuildinfo

# Task runner / bundler caches
.turbo/
.cache/
.parcel-cache/
.next/
.nuxt/
.svelte-kit/

# Test and coverage
coverage/
.nyc_output/
*.lcov

# Environment — never commit real secrets. .env.example is tracked.
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Docker / local infrastructure state
docker/**/data/
infrastructure/**/.terraform/
*.tfstate
*.tfstate.*

# Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages

# Claude Code — share project settings, keep machine-local grants private
.claude/settings.local.json
