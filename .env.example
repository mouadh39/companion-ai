# Nexa — copy to .env and fill in. Never commit .env.
# The backend does not read .env itself. Run it with:
#   node --env-file=.env dist/index.js

# Which provider the composition root binds at startup: anthropic | groq | scripted.
NEXA_MODEL_PROVIDER=groq

# Model provider. Only the active provider's key is required.
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Model id. Defaults per provider when unset:
#   anthropic -> claude-opus-5
#   groq      -> llama-3.3-70b-versatile
# Groq's catalogue moves faster than releases do; list what is live with
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
NEXA_MODEL_ID=

# Ceiling on one provider request, in milliseconds. A backstop beneath the turn
# budget, which Core already enforces.
NEXA_PROVIDER_TIMEOUT_MS=30000

# HTTP
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Postgres connection string for durable memory. Leave blank to keep memory
# in-process (it will not survive a restart).
# Supabase: Project Settings -> Database -> Connection string -> URI
DATABASE_URL=

# Embeddings for semantic memory. Leave blank for lexical-only retrieval.
# Must match the vector(N) column in migration 0003.
OPENAI_API_KEY=
NEXA_EMBEDDING_MODEL=text-embedding-3-small
NEXA_EMBEDDING_DIMENSIONS=1536

# Authentication. Two ways to verify the Supabase access tokens clients present
# as `Authorization: Bearer <token>` — configure exactly one:
#
# 1. SUPABASE_URL — the project's base URL, e.g.
#    https://<ref>.supabase.co. Use this for a project on ASYMMETRIC JWT
#    signing (ES256/RS256): it has no shared secret to give this backend and
#    publishes a rotating public key set at /auth/v1/.well-known/jwks.json,
#    which the backend fetches and caches. NOT a secret — it is the project's
#    public API address. This is what `nexa-dev` uses.
#
# 2. SUPABASE_JWT_SECRET — the legacy HS256 shared secret, for a project that
#    still signs with one. Supabase: Project Settings -> API -> JWT Settings.
#    Server-side ONLY: whoever holds it can mint a token for any account. It
#    must never appear in a Unity asset, a client build, or anything shipped.
#
# Leave BOTH blank and the backend refuses every request (401) rather than
# falling back to trusting identifiers in the request body.
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# A second, separate secret this backend uses to sign and verify the
# device-scoped access tokens it issues to a headset at pairing (Step 3E) —
# audience `nexa-device`. Deliberately not the same value as
# SUPABASE_JWT_SECRET: a leak of either must not compromise the other, and
# this backend controls this secret's rotation independently of Supabase's.
#
# Server-side only, for the same reason SUPABASE_JWT_SECRET is. Leave it
# blank and headset pairing/refresh is unavailable while phone/Supabase
# authentication continues exactly as before — the two are read
# independently and neither's absence affects the other.
NEXA_DEVICE_TOKEN_SECRET=
