{
  "name": "@nexa/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "start": "node dist/index.js",
    "dev": "node --watch dist/index.js",
    "test": "vitest run --passWithNoTests",
    "clean": "node ../../scripts/clean.mjs",
    "lint": "eslint src test --no-error-on-unmatched-pattern --max-warnings 0"
  },
  "dependencies": {
    "@nexa/shared": "workspace:*",
    "@nexa/models": "workspace:*",
    "@nexa/events": "workspace:*",
    "@nexa/actions": "workspace:*",
    "@nexa/core": "workspace:*",
    "@nexa/providers": "workspace:*",
    "fastify": "^5.2.0"
  }
}
