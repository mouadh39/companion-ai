{
  "name": "@nexa/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "start": "node dist/index.js",
    "dev": "node --watch dist/index.js",
    "test": "vitest run --passWithNoTests",
    "clean": "node ../../scripts/clean.mjs",
    "lint": "eslint src test --no-error-on-unmatched-pattern --max-warnings 0"
  },
  "dependencies": {
    "@nexa/actions": "workspace:*",
    "@nexa/core": "workspace:*",
    "@nexa/events": "workspace:*",
    "@nexa/identity": "workspace:*",
    "@nexa/memory": "workspace:*",
    "@nexa/models": "workspace:*",
    "@nexa/perception": "workspace:*",
    "@nexa/personality": "workspace:*",
    "@nexa/planning": "workspace:*",
    "@nexa/providers": "workspace:*",
    "@nexa/reflection": "workspace:*",
    "@nexa/relationship": "workspace:*",
    "@nexa/retrieval": "workspace:*",
    "@nexa/self": "workspace:*",
    "@nexa/shared": "workspace:*",
    "fastify": "^5.2.0",
    "jose": "^6.2.10",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
